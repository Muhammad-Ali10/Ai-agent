# ============================================================
#  SECRET KEYS - Yeh file example hai (isko copy karke ".env" banao)
#  ".env" file kabhi kisi ko share/upload NAHI karni (passwords jaisi hai)
# ============================================================

# ---- Google Sheet ----
# Sheet ka ID (Sheet ke URL me se) - example URL:
# https://docs.google.com/spreadsheets/d/ >>1AbCdEfGhIjKl<< /edit
GOOGLE_SHEET_ID=yahan_sheet_id_dalo

# Service account JSON file ka naam (credentials folder ke andar)
GOOGLE_CREDENTIALS_FILE=credentials/service-account.json

# ---- Pinterest ----
# developers.pinterest.com pe app banane ke baad milte hain:
PINTEREST_APP_ID=yahan_app_id_dalo
PINTEREST_APP_SECRET=yahan_app_secret_dalo
PINTEREST_REDIRECT_URI=http://localhost:8000/callback
# Default board jahan pins jayengi (pinterest_auth.py chalane pe list milti hai):
PINTEREST_BOARD_ID=

# ---- Facebook / Instagram (Phase 4 me bharenge - abhi khali chhodo) ----
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# ---- Email Alerts (optional - khali chhodo to email band rahegi) ----
# Gmail "App Password" chahiye (normal password NAHI chalega):
# myaccount.google.com > Security > 2-Step Verification ON karo
# > phir "App passwords" > naya banao > 16 harf ka password yahan paste karo
EMAIL_SENDER=muhammadalitahir6232@gmail.com
EMAIL_APP_PASSWORD=

# ---- Safety Settings ----
# TEST MODE: true = post nahi karega sirf dikhayega (dry-run) | false = asli post
TEST_MODE=true
